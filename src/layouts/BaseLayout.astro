---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import socialPhoto from '../assets/photos/tornado.jpg';
import { siteConfig } from '../config/site';
interface Props { title?: string; noindex?: boolean }
const social = await getImage({ src: socialPhoto, width: 1200, height: 630, fit: 'cover', position: 'attention', format: 'jpg' });
const canonical = new URL(Astro.url.pathname, Astro.site);
const { title = 'Piotr Muskalski — Code. Sound. Everything in between.', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Software engineer. Born in Poland. Code, sound, and everything in between." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(social.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="At the Exploratorium, reaching toward an indoor tornado" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="description" content="Software engineer. Born in Poland. Software, music and sound design, sports, and travel — a few things that make me, me." />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap">
      <header><nav aria-label="Main navigation">
        <a class="brand" href="/" aria-label="muskalski.com home">muskalski<span>.com</span></a>
        <div class="navlinks mono"><a href="/#about">About</a><a href="/#outside">Photos</a><a href="/#contact">Contact ↗</a></div>
      </nav></header>
      <main id="main"><slot /></main>
      <footer class="end"><a class="brand" href="/">muskalski<span>.com</span></a><div class="footer-links mono">{siteConfig.linkedInUrl && <a href={siteConfig.linkedInUrl}>LinkedIn ↗</a>}<a href="/#contact">Get in touch ↗</a><span>© {new Date().getFullYear()} Piotr Muskalski</span></div></footer>
    </div>
  </body>
</html>
