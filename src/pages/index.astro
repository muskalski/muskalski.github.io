---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
---
<BaseLayout>
  <section class="hero" aria-labelledby="headline">
    <div><div class="eyebrow mono"><span class="dot" aria-hidden="true"></span>Software engineer · Born in Poland</div>
      <h1 id="headline">Code. Sound.<br />Everything <span class="serif">in between.</span></h1>
      <p class="intro">I build software and explore new technologies.</p>
      <a class="jump mono" href="#about">A little about me <span aria-hidden="true">↘</span></a>
    </div>
  </section>
  <div class="ticker mono" aria-label="Interests"><span>Software</span><b aria-hidden="true">·</b><span>Music &amp; sound design</span><b aria-hidden="true">·</b><span>Sports</span><b aria-hidden="true">·</b><span>Travel</span></div>
  <section class="about" id="about" aria-labelledby="about-title"><div class="section-number mono">01 — About</div><div><h2 id="about-title">Software engineer.<br /><span class="serif">Born in Poland.</span></h2><p>I build software and explore new technologies. Outside of programming, I enjoy making music, exploring sound design, staying active, and traveling.</p></div></section>
  <section id="outside" aria-labelledby="outside-title"><div class="gallery-head"><div><div class="section-number mono">02 — A few moments</div><h2 id="outside-title">A different kind of <span class="serif">balance.</span></h2></div></div><PhotoGallery /></section>
  <section class="contact" id="contact" aria-labelledby="contact-title"><div><div class="section-number mono">03 — Contact</div><h2 id="contact-title">Say <span class="serif">hello.</span></h2></div><ContactForm /></section>
</BaseLayout>
